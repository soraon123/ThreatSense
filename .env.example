# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Template for environment variables
#
# HOW TO USE:
#   1. Copy this file:  copy .env.example .env
#   2. Fill in your real values inside .env
#   3. Never commit .env to Git (it is already in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB Connection ────────────────────────────────────────────────────────
# Option A: Local MongoDB (default for development)
MONGO_URI=mongodb://localhost:27017/

# Option B: MongoDB Atlas (cloud) — replace the placeholder
# MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/

# Name of the database this application will use
MONGO_DB_NAME=threat_response_db

# ── Monitoring Settings ───────────────────────────────────────────────────────
# How often (in seconds) to collect a new process snapshot
MONITOR_INTERVAL_SECONDS=30

# Keep process snapshots for this many days before deleting them
SNAPSHOT_RETENTION_DAYS=7

# ── Alert Thresholds ──────────────────────────────────────────────────────────
# A process is flagged for high CPU if it stays above this % for several checks
CPU_ALERT_THRESHOLD=80

# A process is flagged for high memory if it uses more than this many MB
MEMORY_ALERT_THRESHOLD_MB=500

# How many consecutive high-CPU readings before an alert is created
CPU_ALERT_CONSECUTIVE_COUNT=3

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Set to "true" to enable the optional machine-learning anomaly detector
ENABLE_ML_DETECTOR=false

